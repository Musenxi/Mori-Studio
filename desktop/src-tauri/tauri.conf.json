{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MORI Studio",
  "version": "0.0.1",
  "identifier": "app.mori.studio",
  "build": { "frontendDist": "../launcher" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "MORI Studio", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
